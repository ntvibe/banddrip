{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banddrip.dev/schema/reading.schema.json",
  "title": "BandDripReading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "glucose",
    "units",
    "glucoseTimestampMs",
    "delta",
    "trend"
  ],
  "properties": {
    "type": {
      "const": "reading"
    },
    "glucose": {
      "type": "number"
    },
    "units": {
      "enum": ["mg/dL", "mmol/L"]
    },
    "glucoseTimestampMs": {
      "type": "integer",
      "minimum": 1
    },
    "delta": {
      "type": ["number", "null"],
      "description": "Current glucose minus immediately previous valid glucose reading. Null only when no previous valid reading exists."
    },
    "trend": {
      "enum": ["doubleUp", "singleUp", "fortyFiveUp", "flat", "fortyFiveDown", "singleDown", "doubleDown", "unknown"]
    },
    "iobUnits": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "iobTimestampMs": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "sequence": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "source": {
      "type": ["string", "null"]
    }
  }
}

{
  "name": "banddrip-vela",
  "version": "0.1.0",
  "private": true,
  "description": "BandDrip Xiaomi Vela wearable app",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "aiot start --watch",

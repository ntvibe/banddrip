{
  "package": "org.banddrip.app",
  "name": "BandDrip Writer Probe",
  "icon": "/common/icon.svg",
  "versionName": "0.1.1-probe",
  "versionCode": 2,
  "minAPILevel": 1,
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.file" }
  ],
  "config": {
    "logLevel": "debug",
    "designWidth": 212
  },
  "router": {
    "entry": "pages/probe",
    "pages": {
      "pages/probe": {
        "component": "probe",
        "path": "/",
        "launchMode": "singleTask"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}
